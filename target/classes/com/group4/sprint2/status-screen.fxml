<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.shape.Rectangle?>



<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group4.sprint2.Controllers.StatusController"
            stylesheets="@styles/global.css, @styles/statusScreen.css"
            styleClass="primary-bg">
        <VBox alignment="TOP_CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            
            <Label alignment = "CENTER" text="Set Table Status" styleClass="header-label"/>

            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <HBox alignment="CENTER" spacing="20.0">
                <Button text="Available" onAction="#handleAvailable" styleClass="button"/>
                <Button text="Occupied" onAction="#handleOccupied" styleClass="button"/>
                <Button text="Dirty" onAction="#handleDirty" styleClass="button"/>
            </HBox>

            <Button fx:id="exitButton" alignment="CENTER" text ="Exit" onAction="#handleExit" styleClass="button"/>

        </VBox>
            
</AnchorPane>
