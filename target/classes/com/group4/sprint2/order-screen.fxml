<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.shape.Rectangle?>



<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group4.sprint2.Controllers.OrderController"
            stylesheets="@styles/global.css, @styles/orderScreen.css"
            styleClass="primary-bg">
            <HBox alignment="CENTER" spacing="10.0" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                <VBox layoutX="50.0" layoutY="50.0" spacing="10.0"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

                    <Label fx:id = "tableLabel" 
                        alignment = "CENTER" 
                        text="" 
                        styleClass="header-label, waiter-label" />
                    <Button fx:id="soupButton"
                        text = "Soups" 
                        onAction="#categorySelected" 
                        styleClass="category-button"/>
                    <Button fx:id="saladButton"
                        text = "Salads" 
                        onAction="#categorySelected" 
                        styleClass="category-button"/>
                    <Button fx:id="entreeButton"
                        text = "Entrees" 
                        onAction="#categorySelected" 
                        styleClass="category-button"/>
                    <Button fx:id="drinksButton"
                        text = "Drinks" 
                        onAction="#categorySelected" 
                        styleClass="category-button"/>
                      <Button fx:id="dessertButton"
                        text = "Desserts" 
                        onAction="#categorySelected" 
                        styleClass="category-button"/>  
                </VBox>

                <VBox fx:id="foodOptionsPanel" visible="false" managed="false"
                    styleClass="foodPanel" spacing="10">
                    <Button fx:id="button1" text="" onAction="#onFoodItemClick"/>
                    <Button fx:id="button2" text="" onAction="#onFoodItemClick"/>
                    <Button fx:id="button3" text="" onAction="#onFoodItemClick"/>
                    <Button fx:id="button4" text="" onAction="#onFoodItemClick"/>
                </VBox>
                <Button fx:id = "completeButton" text="Complete Order" onAction="#completeOrder" styleClass="view-order-button"/>
            </HBox>
</AnchorPane>
