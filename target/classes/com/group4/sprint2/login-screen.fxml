<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>

<?import javafx.scene.control.Button?>


<!-- <VBox stylesheets="@style.css"> ... </VBox -->

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group4.sprint2.Controllers.LoginController"
            stylesheets="@styles/global.css, @styles/loginScreen.css"
            styleClass="primary-bg">
        <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <Label fx:id= "invalidLabel" text="" styleClass="header-label, login-label"/>
            <TextField fx:id="usernameField" 
                promptText="Username"
                maxWidth= "250.0" 
                prefWidth="250.0" 
                prefHeight="40.0" />
            <PasswordField fx:id="passwordField" 
                promptText="Password"
                maxWidth= "250.0" 
                prefWidth="250.0" 
                prefHeight="40.0" />  

                         
            <Button fx:id="loginButton" 
                text="Login" 
                onAction="#onLoginButtonClick"
                maxWidth= "250.0" 
                prefWidth="250.0" 
                prefHeight="40.0" />  
        </VBox>                
</AnchorPane>
